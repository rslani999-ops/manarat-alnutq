const json = (data, status = 200) =>
  new Response(JSON.stringify(data, null, 2), {
    status,
    headers: { "content-type": "application/json; charset=utf-8" }
  });

export default {
  async fetch(request, env) {
    const url = new URL(request.url);

    // Real AI endpoint: POST /api/ai
    if (url.pathname === "/api/ai") {
      if (request.method !== "POST") return json({ error: "استخدم POST" }, 405);

      try {
        const body = await request.json();
        const {
          studentName = "الطالب",
          letter = "",
          stage = "",
          results = {},
          role = "teacher"
        } = body || {};

        if (!letter || !stage) {
          return json({ error: "بيانات الجلسة ناقصة" }, 400);
        }

        if (!env.AI) {
          return json({
            error: "لم يتم تفعيل Workers AI Binding بعد.",
            setup: "فعّل Workers AI binding باسم AI في إعدادات Worker."
          }, 503);
        }

        const audience = role === "student"
          ? "الطالب طفل بين 4 و12 سنة؛ استخدم لغة قصيرة مشجعة وآمنة."
          : "المستخدم معلم تدريبات نطق؛ أعطه توصيات تعليمية عملية قابلة للتوثيق.";

        const prompt = `أنت مساعد متخصص في تصميم تدريبات نطق عربية للأطفال من 4 إلى 12 سنة.
مهمتك دعم التدريب التعليمي فقط، ولا تقدم تشخيصاً طبياً أو بديلاً عن أخصائي التخاطب.

${audience}

الحرف المستهدف: ${letter}
مرحلة الجلسة: ${stage}
بيانات الأداء: ${JSON.stringify(results)}

أعط إجابة عربية واضحة:
1) ملاحظة عن الأداء.
2) تمرين عملي قصير للجلسة التالية.
3) نصيحة للمعلم أو تشجيع للطالب حسب الجمهور.
4) لا تدّع وجود تشخيص.
5) اجعل الأنشطة مناسبة لعمر الطفل.`;

        const result = await env.AI.run("@cf/meta/llama-3.1-8b-instruct", {
          prompt,
          max_tokens: 700
        });

        return json({
          ok: true,
          role,
          letter,
          stage,
          recommendation: result?.response || result
        });
      } catch (error) {
        return json({ error: "تعذر تشغيل المساعد الذكي", detail: String(error?.message || error) }, 500);
      }
    }

    // Health check for deployment verification.
    if (url.pathname === "/api/health") {
      return json({ ok: true, app: "منارة النطق", version: "Workers v1" });
    }

    // Static assets are served by Cloudflare's Assets binding.
    if (env.ASSETS) return env.ASSETS.fetch(request);

    return new Response("منارة النطق", { status: 404 });
  }
};
